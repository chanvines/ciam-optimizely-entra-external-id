@{
    Layout = null;
    var verifyCode = ViewBag.VerifyCode == true;
    var title = verifyCode ? "Verify your email" : "Create an account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title | Valora</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f4f6f8; color: #142238; font-family: Arial, sans-serif; }
        header { padding: 24px; background: #142238; color: #fff; }
        header strong { color: #c4ad72; }
        main { max-width: 460px; margin: 32px auto; padding: 32px; background: #fff; border-radius: 12px; }
        label { display: block; margin-top: 16px; }
        input, button { width: 100%; padding: 12px; margin-top: 8px; border-radius: 6px; font: inherit; }
        input { border: 1px solid #8996a6; }
        button { margin-top: 24px; background: #142238; color: #fff; border: 0; cursor: pointer; }
        a { color: #142238; }
        :focus-visible { outline: 3px solid #b29a60; outline-offset: 3px; }
        [role=alert] { color: #9a2828; }
        @@media (max-width: 520px) { main { margin: 24px 16px; padding: 24px; } }
    </style>
</head>
<body>
    <header><strong>VALORA</strong> | ASSET MANAGEMENT</header>
    <main>
        <h1>@title</h1>
        @if (ViewBag.Message != null) { <p role="alert">@ViewBag.Message</p> }
        @if (verifyCode)
        {
            <p>Enter the code we sent to your email to create your account.</p>
            <form method="post" action="/client/signup/verify">
                @Html.AntiForgeryToken()
                <label for="code">Verification code</label>
                <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="32" required />
                <button type="submit">Verify and create account</button>
            </form>
            <p><a href="/client/signup">Start again</a></p>
        }
        else
        {
            <form method="post" action="/client/signup">
                @Html.AntiForgeryToken()
                <label for="firstName">First name</label>
                <input id="firstName" name="firstName" autocomplete="given-name" maxlength="64" required />
                <label for="lastName">Last name</label>
                <input id="lastName" name="lastName" autocomplete="family-name" maxlength="64" required />
                <label for="email">Email address</label>
                <input id="email" name="email" type="email" autocomplete="username" maxlength="254" required />
                <label for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                <label for="confirmPassword">Confirm password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="256" required />
                <button type="submit">Send verification code</button>
            </form>
        }
        <p><a href="/client/login">Back to sign in</a></p>
    </main>
</body>
</html>
