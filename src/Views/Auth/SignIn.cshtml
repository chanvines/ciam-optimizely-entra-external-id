@{
    Layout = null;
    ViewData["Title"] = "Client Login | Valora Asset Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #15283f;
        }

        .header {
            background: #15283f;
            color: white;
            padding: 25px 50px;
            font-size: 22px;
            font-weight: bold;
        }

        .container {
            max-width: 420px;
            margin: 80px auto;
            padding: 40px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }

        h1 {
            margin-bottom: 10px;
        }

        .subtitle {
            color: #667085;
            margin-bottom: 30px;
        }

        label {
            display: block;
            margin: 18px 0 8px;
        }

        input {
            box-sizing: border-box;
            width: 100%;
            padding: 13px;
            border: 1px solid #ccd3da;
            border-radius: 6px;
            font-size: 15px;
        }

        button {
            width: 100%;
            margin-top: 28px;
            padding: 14px;
            background: #15283f;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
        }

        .links {
            margin-top: 25px;
            text-align: center;
        }

        .links a {
            color: #15283f;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="header">
        VALORA | ASSET MANAGEMENT
    </div>

    <div class="container">

        <h1>Welcome back</h1>

        <p class="subtitle">
            Sign in to securely access your investment portal.
        </p>

        <form method="post" action="/client/login">
              @Html.AntiForgeryToken()

            <label for="email">Email address</label>
            <input type="email"
                   id="email"
                   name="email"
                   autocomplete="username"
                   required />

            <label for="password">Password</label>
            <input type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                required />

            <button type="submit">
                   Sign in
            </button>

        </form>
        @if (ViewBag.Message != null)
        {
        <p style="margin-top:20px; color:#15283f;">
           @ViewBag.Message
        </p>
        }

        <div class="links">

            <p>
                <a href="/client/forgot-password">
                    Forgot your password?
                </a>
            </p>

            <p>
                New to Valora?
                <a href="/client/signup">Create an account</a>
            </p>

        </div>

    </div>

</body>
</html>
