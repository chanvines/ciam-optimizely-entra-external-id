@{
    Layout = null;

    var step = ViewBag.Step as string ?? "email";

    ViewData["Title"] = "Reset Password | Valora";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #15283f;
        }

        header {
            padding: 25px 50px;
            background: #15283f;
            color: white;
            font-size: 22px;
            font-weight: bold;
        }

        .container {
            max-width: 430px;
            margin: 80px auto;
            padding: 40px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,.08);
        }

        input {
            box-sizing: border-box;
            width: 100%;
            padding: 13px;
            margin: 12px 0;
            border: 1px solid #ccd3da;
            border-radius: 6px;
        }

        button {
            width: 100%;
            margin-top: 20px;
            padding: 14px;
            background: #15283f;
            color: white;
            border: 0;
            border-radius: 6px;
            cursor: pointer;
        }

        a {
            color: #15283f;
        }

        .message {
            margin-top: 20px;
        }
    </style>
</head>

<body>

<header>
    VALORA | ASSET MANAGEMENT
</header>

<div class="container">

    @if (step == "email")
    {
        <h1>Forgot your password?</h1>

        <p>
            Enter your email address to reset your password.
        </p>

        <form method="post"
              action="/client/forgot-password/start">

            @Html.AntiForgeryToken()

            <label for="email">Email address</label>

            <input type="email"
                   name="email"
                   id="email"
                   autocomplete="email"
                   required />

            <button type="submit">
                Continue
            </button>

        </form>
    }
    else if (step == "otp")
    {
        <h1>Verify your email</h1>

        <p>
            Enter the verification code sent to your email.
        </p>

        <form method="post"
              action="/client/forgot-password/verify">

            @Html.AntiForgeryToken()

            <label for="code">Verification code</label>

            <input type="text"
                   name="code"
                   id="code"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   required />

            <button type="submit">
                Verify code
            </button>

        </form>
    }
    else if (step == "password")
    {
        <h1>Create a new password</h1>

        <form method="post"
              action="/client/forgot-password/submit">

            @Html.AntiForgeryToken()

            <label for="newPassword">New password</label>

            <input type="password"
                   name="newPassword"
                   id="newPassword"
                   autocomplete="new-password"
                   required />

            <label for="confirmPassword">
                Confirm new password
            </label>

            <input type="password"
                   name="confirmPassword"
                   id="confirmPassword"
                   autocomplete="new-password"
                   required />

            <button type="submit">
                Reset password
            </button>

        </form>
    }
    else if (step == "poll")
    {
        <h1>Updating your password</h1>

        <p>
            Your request is being processed.
            Please wait a moment before checking its status.
        </p>

        <form method="post"
              action="/client/forgot-password/status">

            @Html.AntiForgeryToken()

            <button type="submit">
                Check status
            </button>

        </form>
    }

    @if (ViewBag.Message != null)
    {
        <p class="message" role="alert">
            @ViewBag.Message
        </p>
    }

    <p style="text-align:center; margin-top:30px;">
        <a href="/client/login">Back to Sign In</a>
    </p>

</div>

</body>
</html>